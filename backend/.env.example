# Copy to backend/.env (loaded by `npm start` / `npm run demo`) or set in your host. Never commit real values.

# "gemini" (default) runs the Python engine; "demo" returns a bundled sample image
# with a DEMO banner and needs no API key.
STAGING_MODE=demo

# Required when STAGING_MODE=gemini
GEMINI_API_KEY=your-gemini-api-key
# Optional: gemini-flash (default, gemini-2.5-flash-image), gemini-pro, or a full model id
GEMINI_IMAGE_MODEL=gemini-flash
# Optional: model for room analysis and the quality judge
# GEMINI_VISION_MODEL=gemini-2.5-flash
# Optional: renders per round and retry rounds (each render also gets one judge call)
# STAGING_CANDIDATES=2
# STAGING_MAX_RETRIES=1

# "Virtually Staged" label on downloads (on by default; many MLSs require disclosure)
# DISCLOSURE_WATERMARK=on

# Required in production so sessions survive restarts
JWT_SECRET=change-me-to-a-long-random-string

PORT=3099
# Optional: where the SQLite DB, uploads, results and thumbnails live (default backend/data)
# DATA_DIR=/data
# Optional: Python interpreter used for the engine (default python3)
# PYTHON_BIN=python3
